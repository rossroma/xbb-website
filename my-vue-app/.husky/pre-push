#!/usr/bin/env sh
. "$(dirname "$0")/_/husky.sh"

while read -r local_ref local_sha remote_ref remote_sha; do
  branch=$(echo "$remote_ref" | sed 's|refs/heads/||')

  if [ "$branch" = "develop" ] || [ "$branch" = "main" ]; then
    echo ""
    echo "🔍 推送到 $branch 分支，执行质量门禁..."

    echo ""
    echo "📋 类型检查 (vue-tsc --build)..."
    if ! pnpm type-check; then
      echo ""
      echo "❌ 类型检查失败，推送已取消。"
      exit 1
    fi

    echo ""
    echo "📋 Lint 检查 (oxlint)..."
    if ! pnpm lint:oxlint; then
      echo ""
      echo "❌ Lint 检查失败，推送已取消。"
      exit 1
    fi

    echo ""
    echo "✅ 质量门禁通过，允许推送。"
  fi
done

exit 0